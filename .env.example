# Copy to .env (not committed) and fill in. `docker compose` reads it
# automatically; restart the API afterwards: docker compose up -d api
#
# Sign-in with Google and Microsoft. A provider's button appears on the login
# page only when its client id is set. Redirect URIs to register:
#   local: http://localhost:4321/auth/google/callback
#          http://localhost:4321/auth/microsoft/callback
#   prod:  https://duradent.pe/auth/google/callback
#          https://duradent.pe/auth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (work and personal accounts), organizations, consumers or a tenant id
MICROSOFT_TENANT=common

# Culqi sandbox keys (optional; without them payments are simulated)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Nubefact demo account (optional; without it SUNAT documents are simulated)
NUBEFACT_URL=
NUBEFACT_TOKEN=
