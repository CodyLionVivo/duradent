---
// Company logo (store with a tooth sign) and wordmark. The image is
// decorative; the accessible name comes from the surrounding link.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <img src="/brand/logo.svg" alt="" width="36" height="36" class="h-9 w-9 shrink-0" />
  <span class="text-lg font-bold tracking-tight text-ink">Duradent</span>
</span>
