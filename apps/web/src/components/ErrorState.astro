---
import { localePath, useTranslations } from '../i18n';

interface Props {
  kind: 'notFound' | 'unavailable';
}

const { kind } = Astro.props;
const { locale } = Astro.locals;
const t = useTranslations(locale);
---

<section class="container-page flex flex-col items-center py-24 text-center">
  <p class="text-sm font-semibold text-brand-700">{kind === 'notFound' ? '404' : '503'}</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight">{t(kind === 'notFound' ? 'errors.notFoundTitle' : 'errors.unavailableTitle')}</h1>
  <p class="mt-3 max-w-md text-muted">{t(kind === 'notFound' ? 'errors.notFoundText' : 'errors.unavailableText')}</p>
  <a href={localePath(locale)} class="btn-primary mt-8">{t('errors.backHome')}</a>
</section>
