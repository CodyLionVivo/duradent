---
import { formatMoney, localePath, useTranslations } from '../i18n';
import type { ProductSummary, Quote } from '../lib/catalog';

interface Props {
  product: ProductSummary;
  quote?: Quote;
  /** Lazy-load images below the fold. */
  eager?: boolean;
}

const { product, quote, eager = false } = Astro.props;
const { locale, currency } = Astro.locals;
const t = useTranslations(locale);
const href = localePath(locale, `/product/${product.slug}`);

// Lowest unit price shown: the best volume tier of the default variant. It is
// labelled "from" whenever a buyer could pay more (fewer units, other variants).
const lowest = quote ? (quote.tiers.at(-1)?.unit_price ?? quote.unit_price) : undefined;
const isFrom = !!quote && (quote.tiers.length > 1 || product.variant_count > 1);
---

<article class="card group relative flex flex-col overflow-hidden transition-shadow hover:shadow-md focus-within:shadow-md">
  <div class="aspect-square bg-surface">
    {product.image ? (
      <img
        src={product.image.url}
        alt={product.image.alt}
        width="480"
        height="480"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-contain p-4 transition-transform group-hover:scale-[1.02]"
      />
    ) : (
      <div class="flex h-full items-center justify-center text-brand-200" role="img" aria-label={t('product.noImage')}>
        <svg aria-hidden="true" viewBox="0 0 48 48" class="h-16 w-16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 10c3.5-2 6.2-1 9 .6 2.8-1.6 5.5-2.6 9-.6 4 2.5 3.8 8.4 2.3 13.5-1.4 4.8-2.4 11.5-5 11.5-2.4 0-2.7-6-6.3-6s-3.9 6-6.3 6c-2.6 0-3.6-6.7-5-11.5C11.2 18.4 11 12.5 15 10Z" />
        </svg>
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    {product.brand && <p class="text-xs font-medium uppercase tracking-wide text-muted">{product.brand}</p>}
    <h3 class="text-sm font-semibold leading-snug text-ink">
      <a href={href} class="after:absolute after:inset-0 focus:outline-none">{product.name}</a>
    </h3>
    {product.variant_count > 1 && (
      <p class="text-xs text-muted">{t('catalog.variantCount', { count: product.variant_count })}</p>
    )}
    <p class="mt-auto pt-3 text-base font-semibold text-brand-800">
      {lowest ? (
        <>
          {isFrom && <span class="text-xs font-normal text-muted">{t('catalog.from')} </span>}
          {formatMoney(lowest, currency, locale)}
        </>
      ) : (
        <span class="text-sm font-medium text-muted">{t('catalog.priceOnRequest')}</span>
      )}
    </p>
  </div>
</article>
