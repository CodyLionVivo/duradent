---
import { formatMoney, localePath, useTranslations } from '../i18n';
import { getCategories, type ProductSummary, type Quote } from '../lib/catalog';
import { artKind, artTint } from '../lib/art';
import ProductArt from './ProductArt.astro';

interface Props {
  product: ProductSummary;
  quote?: Quote;
  /** Lazy-load images below the fold. */
  eager?: boolean;
}

const { product, quote, eager = false } = Astro.props;
const { locale } = Astro.locals;
const t = useTranslations(locale);
const href = localePath(locale, `/product/${product.slug}`);
// Categories are cached per locale, so this costs no API call per card.
const categories = product.image ? [] : await getCategories(Astro.locals.api, locale).catch(() => []);

// Lowest unit price shown: the best volume tier of the default variant. It is
// labelled "from" whenever a buyer could pay more (fewer units, other variants).
const lowest = quote ? (quote.tiers.at(-1)?.unit_price ?? quote.unit_price) : undefined;
const isFrom = !!quote && (quote.tiers.length > 1 || product.variant_count > 1);

// Fixed structure (one-line brand, two-line name, a reserved options line) so
// every card in a grid has the same height and the prices line up. Empty
// slots keep their line with a non-breaking space.
const blank = '\u00a0';
---

<article class="card group relative flex h-full flex-col overflow-hidden transition duration-300 hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[0_12px_30px_-12px_rgb(4_104_128_/_0.35)] focus-within:shadow-md">
  <div class="aspect-square bg-surface">
    {product.image ? (
      <img
        src={product.image.url}
        alt={product.image.alt}
        width="480"
        height="480"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-contain p-4 transition-transform group-hover:scale-[1.02]"
      />
    ) : (
      <ProductArt kind={artKind(categories, product.category_id)} tint={artTint(product.slug)} label={t('product.noImage')} />
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <p class="truncate text-xs font-medium uppercase tracking-wide text-muted">{product.brand || blank}</p>
    <h3 class="line-clamp-2 min-h-[2.5rem] text-sm font-semibold leading-5 text-ink" title={product.name}>
      <a href={href} class="after:absolute after:inset-0 focus:outline-none">{product.name}</a>
    </h3>
    <p class="min-h-4 text-xs leading-4 text-muted">
      {product.variant_count > 1 ? t('catalog.variantCount', { count: product.variant_count }) : blank}
    </p>
    <p class="mt-auto pt-3 text-base font-semibold text-brand-800">
      {lowest ? (
        <>
          {isFrom && <span class="text-xs font-normal text-muted">{t('catalog.from')} </span>}
          {formatMoney(lowest, locale)}
        </>
      ) : (
        <span class="text-sm font-medium text-muted">{t('catalog.priceOnRequest')}</span>
      )}
    </p>
  </div>
</article>
