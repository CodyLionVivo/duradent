---
import Logo from './Logo.astro';
import { localePath, useTranslations } from '../i18n';
import { getCategories, topLevel, type Category } from '../lib/catalog';
import { LEGAL_PAGES, PHONE } from '../lib/legal';

const { locale } = Astro.locals;
const t = useTranslations(locale);
const year = new Date().getFullYear();

// Official accounts of Duradent SAC.
const socials = [
  {
    href: 'https://www.facebook.com/duradentsac/',
    label: t('footer.facebook'),
    icon: 'M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v6h4v-6h3l.5-4h-3.5V9c0-.6.4-1 1-1Z',
    fill: true,
  },
  {
    href: 'https://www.instagram.com/duradent_sac/',
    label: t('footer.instagram'),
    icon: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3ZM12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6ZM17.2 6.6h.01',
    fill: false,
  },
];

let categories: Category[] = [];
try {
  categories = topLevel(await getCategories(Astro.locals.api, locale)).slice(0, 5);
} catch {
  // Footer renders without category links if the API is down.
}
---

<footer class="mt-20 border-t border-line bg-surface">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Logo />
      <p class="mt-3 max-w-sm text-sm text-muted">{t('footer.tagline')}</p>
      <h2 class="mt-6 text-sm font-semibold text-ink">{t('footer.follow')}</h2>
      <ul class="mt-3 flex gap-3" role="list">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              title={s.label}
              class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white text-brand-700 transition hover:-translate-y-0.5 hover:border-brand-500 hover:bg-brand-700 hover:text-white"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill={s.fill ? 'currentColor' : 'none'} stroke={s.fill ? 'none' : 'currentColor'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-ink">{t('footer.shop')}</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted" role="list">
        <li><a class="hover:text-brand-700" href={localePath(locale, '/catalog')}>{t('nav.catalog')}</a></li>
        {categories.map((c) => (
          <li><a class="hover:text-brand-700" href={localePath(locale, `/catalog/${c.slug}`)}>{c.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-ink">{t('footer.help')}</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted" role="list">
        {LEGAL_PAGES.map((p) => (
          <li><a class="hover:text-brand-700" href={localePath(locale, `/legal/${p}`)}>{t(`legal.${p}`)}</a></li>
        ))}
      </ul>
      <h2 class="mt-6 text-sm font-semibold text-ink">{t('footer.contact')}</h2>
      <dl class="mt-3 space-y-2 text-sm text-muted">
        <div>
          <dt class="sr-only">{t('footer.phone')}</dt>
          <dd>
            <a class="inline-flex items-center gap-2 font-semibold text-ink hover:text-brand-700" href={PHONE.href}>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-brand-700" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 3.5 9 3l1.6 4-2 1.3a11 11 0 0 0 7.1 7.1l1.3-2 4 1.6-.5 2.4a2 2 0 0 1-2 1.6A16.5 16.5 0 0 1 3 5.5a2 2 0 0 1 1.6-2Z" /></svg>
              {PHONE.display}
            </a>
          </dd>
        </div>
        <div>
          <dt class="sr-only">{t('footer.visit')}</dt>
          <dd>{t('home.storeAddress')}</dd>
        </div>
      </dl>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="container-page py-5 text-xs text-muted">© {year} {t('footer.company')}. {t('footer.rights')}</p>
  </div>
</footer>
