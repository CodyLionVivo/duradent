---
// Animated background for the hero: slow-drifting colour fields in the brand
// palette over a fading dot grid. Pure CSS; still when the visitor prefers
// reduced motion (global rule in global.css).
---

<div class="hero-backdrop" aria-hidden="true">
  <span class="field field-a"></span>
  <span class="field field-b"></span>
  <span class="field field-c"></span>
  <span class="dots"></span>
  <span class="fade"></span>
</div>

<style>
  .hero-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: linear-gradient(180deg, #effcfb 0%, #f6fbfc 60%, #ffffff 100%);
  }
  /* Soft by their radial gradient, not by a blur filter: animating a blurred
     element forces a repaint every frame and made scrolling the hero sluggish.
     Only transform is animated, on its own compositor layer. */
  .field {
    position: absolute;
    border-radius: 9999px;
    opacity: 0.75;
    will-change: transform;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .field-a {
    width: 38rem;
    height: 38rem;
    left: -12rem;
    top: -16rem;
    background: radial-gradient(circle, #aeeae7 0%, rgb(174 234 231 / 0.35) 35%, transparent 68%);
  }
  .field-b {
    width: 34rem;
    height: 34rem;
    right: -10rem;
    top: -6rem;
    background: radial-gradient(circle, #b9e2ef 0%, rgb(185 226 239 / 0.35) 35%, transparent 68%);
    animation-duration: 26s;
    animation-delay: -6s;
  }
  .field-c {
    width: 26rem;
    height: 26rem;
    left: 38%;
    bottom: -14rem;
    background: radial-gradient(circle, #cdeccf 0%, rgb(205 236 207 / 0.35) 35%, transparent 68%);
    animation-duration: 30s;
    animation-delay: -12s;
  }
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(4 104 128 / 0.14) 1px, transparent 0);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 0%, transparent 75%);
  }
  .fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 6rem;
    background: linear-gradient(180deg, transparent, #ffffff);
  }
  @media (prefers-reduced-motion: reduce) {
    .field { animation: none; }
  }
  @keyframes drift {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(4rem, 2rem, 0) scale(1.08); }
    100% { transform: translate3d(-2rem, 3rem, 0) scale(0.96); }
  }
</style>
