---
// Hero illustration: an archwire that draws itself, brackets that settle on
// it one by one and keep floating, and three glass chips with what Duradent
// offers. The chips repeat visible text, so the scene is hidden from screen
// readers.

interface Props {
  chips: { label: string; icon: string }[];
}

const { chips } = Astro.props;

// Brackets sitting on the archwire, the quadratic curve M40 110 Q240 350
// 440 110: x = 40 + 400t, y = 110 + 480t(1 − t). Each one is tilted to the
// curve's tangent so it looks bonded to the teeth along the arch.
const brackets = [0.1, 0.23, 0.365, 0.5, 0.635, 0.77, 0.9].map((t, i) => ({
  x: 40 + 400 * t,
  y: 110 + 480 * t * (1 - t),
  angle: (Math.atan(1.2 * (1 - 2 * t)) * 180) / Math.PI,
  i,
}));
---

<div class="hero-scene" aria-hidden="true">
  <svg viewBox="0 0 480 380" class="scene">
    <defs>
      <linearGradient id="hero-wire" x1="0" x2="1">
        <stop offset="0" stop-color="#13a3a0" />
        <stop offset="1" stop-color="#046880" />
      </linearGradient>
      <linearGradient id="hero-metal" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffffff" />
        <stop offset="1" stop-color="#d5f5f3" />
      </linearGradient>
      <radialGradient id="hero-halo">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
        <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle cx="240" cy="200" r="190" fill="url(#hero-halo)" />
    <path class="wire-glow" d="M40 110 Q240 350 440 110" stroke="#aeeae7" stroke-width="16" fill="none" stroke-linecap="round" />
    <path class="wire" d="M40 110 Q240 350 440 110" stroke="url(#hero-wire)" stroke-width="6" fill="none" stroke-linecap="round" pathLength="1" />

    <g class="brackets">
      {brackets.map((b) => (
        <g class="bracket" style={`--i:${b.i}`} transform={`translate(${b.x} ${b.y}) rotate(${b.angle.toFixed(1)}) scale(0.68) translate(-27 -38)`}>
          <g class="bracket-body">
            <rect x="5" y="0" width="44" height="12" rx="5" fill="#aeeae7" stroke="#0c6a6b" stroke-width="2.5" />
            <rect x="5" y="64" width="44" height="12" rx="5" fill="#aeeae7" stroke="#0c6a6b" stroke-width="2.5" />
            <rect x="0" y="9" width="54" height="58" rx="16" fill="url(#hero-metal)" stroke="#0c6a6b" stroke-width="3" />
            <rect x="9" y="31" width="36" height="12" rx="4" fill="#046880" opacity="0.85" />
            <path d="M12 18c6-4 18-5 26-2" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
          </g>
        </g>
      ))}
    </g>

    {[[96, 64, 0], [392, 240, 1.4], [250, 40, 2.6], [150, 300, 3.4]].map(([x, y, d]) => (
      <path
        class="spark"
        style={`--d:${d}s`}
        d={`M${x} ${y - 9}l2.5 6.5 6.5 2.5-6.5 2.5-2.5 6.5-2.5-6.5-6.5-2.5 6.5-2.5z`}
        fill="#13a3a0"
      />
    ))}
  </svg>

  <ul class="chips">
    {chips.map((c, i) => (
      <li class={`chip chip-${i}`}>
        <span class="chip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d={c.icon} /></svg>
        </span>
        {c.label}
      </li>
    ))}
  </ul>
</div>

<style>
  .hero-scene {
    position: relative;
  }
  .scene {
    width: 100%;
    overflow: visible;
  }
  .wire {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.6s cubic-bezier(0.6, 0, 0.2, 1) 0.2s forwards;
  }
  .wire-glow {
    opacity: 0;
    animation: fade-in 1s ease 1.4s forwards;
  }
  .bracket {
    opacity: 0;
    animation: settle 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.3) calc(0.7s + var(--i) * 0.09s) forwards;
  }
  .bracket-body {
    animation: float 6s ease-in-out calc(var(--i) * -0.7s) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  .spark {
    transform-box: fill-box;
    transform-origin: center;
    animation: twinkle 3.6s ease-in-out var(--d) infinite;
    opacity: 0;
  }

  .chips {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem 0.55rem 0.55rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.78);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 10px 30px -12px rgb(4 104 128 / 0.35);
    font-size: 0.85rem;
    font-weight: 600;
    color: #1d2733;
    white-space: nowrap;
    opacity: 0;
    animation:
      chip-in 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.2) forwards,
      float 7s ease-in-out infinite;
  }
  .chip-icon {
    display: inline-flex;
    width: 1.9rem;
    height: 1.9rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: linear-gradient(135deg, #13a3a0, #046880);
    color: #ffffff;
  }
  .chip-icon svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .chip-0 { left: 0; top: 0; animation-delay: 1.5s, 1.5s; }
  .chip-1 { right: 0; bottom: 20%; animation-delay: 1.7s, 0.2s; }
  .chip-2 { left: 10%; bottom: 2%; animation-delay: 1.9s, 3.1s; }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-in { to { opacity: 0.55; } }
  /* `translate`, not `transform`: the SVG transform attribute places each bracket. */
  @keyframes settle {
    from { opacity: 0; translate: 0 -18px; }
    to { opacity: 1; translate: 0 0; }
  }
  @keyframes float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -6px; }
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.4); }
    50% { opacity: 0.9; transform: scale(1); }
  }
  @keyframes chip-in {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wire, .wire-glow, .bracket, .bracket-body, .spark, .chip { animation: none; }
    .wire { stroke-dashoffset: 0; }
    .wire-glow { opacity: 0.55; }
    .bracket, .chip { opacity: 1; }
  }
</style>
