---
import { getEntry, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { DEFAULT_LOCALE, INTL_LOCALE, isLocale, localePath, useTranslations } from '../../../i18n';
import { LEGAL_PAGES, isLegalPage } from '../../../lib/legal';

if (!isLocale(Astro.params.locale) || !isLegalPage(Astro.params.slug)) return new Response(null, { status: 404 });

const { locale } = Astro.locals;
const slug = Astro.params.slug;
const t = useTranslations(locale);
const page = await getEntry('legal', `${locale}/${slug}`);
if (!page) return new Response(null, { status: 404 });
const { Content } = await render(page);
const updated = new Intl.DateTimeFormat(INTL_LOCALE[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(page.data.updated);
---

<Layout title={page.data.title} description={page.data.description}>
  <div class="container-page grid gap-10 py-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:py-14">
    <nav aria-label={t('legal.title')} class="lg:sticky lg:top-24 lg:self-start">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted">{t('legal.title')}</p>
      <ul class="mt-3 flex flex-wrap gap-2 lg:flex-col lg:gap-1" role="list">
        {LEGAL_PAGES.map((p) => (
          <li>
            <a
              href={localePath(locale, `/legal/${p}`)}
              aria-current={p === slug ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2 text-sm',
                p === slug ? 'bg-brand-50 font-semibold text-brand-800' : 'text-muted hover:bg-surface hover:text-ink',
              ]}
            >
              {t(`legal.${p}`)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <article class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{page.data.title}</h1>
      <p class="mt-2 text-sm text-muted">{t('legal.updated', { date: updated })}</p>
      {locale !== DEFAULT_LOCALE && (
        <p class="mt-4 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-900">{t('legal.spanishPrevails')}</p>
      )}
      <div class="legal-prose mt-8">
        <Content />
      </div>
    </article>
  </div>
</Layout>
