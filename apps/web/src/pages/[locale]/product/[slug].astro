---
import Layout from '../../../layouts/Layout.astro';
import ErrorState from '../../../components/ErrorState.astro';
import VariantPicker, { type PickerLabels, type PickerQuote } from '../../../components/islands/VariantPicker';
import { INTL_LOCALE, formatMoney, isLocale, localePath, useTranslations } from '../../../i18n';
import { getProduct, getQuotes, type ProductDetail, type Quote } from '../../../lib/catalog';

if (!isLocale(Astro.params.locale)) return new Response(null, { status: 404 });

const { locale, currency } = Astro.locals;
const t = useTranslations(locale);

let product: ProductDetail | null = null;
let quotes = new Map<string, Quote>();
let availability: Record<string, number> = {};
let state: 'ok' | 'notFound' | 'unavailable' = 'ok';
try {
  product = await getProduct(Astro.locals.api, Astro.params.slug ?? '', locale);
  if (!product) state = 'notFound';
  else {
    const ids = product.variants.map((v) => v.id);
    const [q, avail] = await Promise.all([
      getQuotes(Astro.locals.api, ids, currency),
      Astro.locals.api.GET('/v1/inventory/availability', { params: { query: { variant_id: ids } } }),
    ]);
    quotes = q;
    availability = Object.fromEntries((avail.data ?? []).map((a) => [a.variant_id, a.available]));
  }
} catch {
  state = 'unavailable';
}
if (state !== 'ok') Astro.response.status = state === 'notFound' ? 404 : 503;

const requested = Astro.url.searchParams.get('variant');
const initial =
  product?.variants.find((v) => v.id === requested) ?? product?.variants.find((v) => v.is_default) ?? product?.variants[0];

const labels: PickerLabels = {
  chooseOption: t('product.chooseOption'),
  sku: t('product.sku'),
  weight: t('product.grams'),
  unitPrice: t('product.unitPrice'),
  volumePricing: t('product.volumePricing'),
  fromQty: t('product.fromQty'),
  perUnit: t('product.perUnit'),
  taxNote: t('product.taxNote'),
  priceOnRequest: t('product.priceOnRequest'),
  unavailable: t('product.unavailable'),
  addToCart: t('product.addToCart'),
  quantity: t('product.quantity'),
  inStock: t('stock.inStock'),
  outOfStock: t('stock.out'),
};
const pickerQuotes: Record<string, PickerQuote> = Object.fromEntries(
  [...quotes].map(([id, q]) => [id, { unit_price: q.unit_price, tiers: q.tiers }]),
);
const optionLabel = (code: string, value: string) =>
  product?.options.find((o) => o.code === code)?.values.find((v) => v.code === value)?.label ?? value;
const hero = product?.images[0];
---

<Layout title={product?.name} description={product?.description.slice(0, 160) || undefined}>
  {state !== 'ok' || !product ? (
    <ErrorState kind={state === 'unavailable' ? 'unavailable' : 'notFound'} />
  ) : (
    <div class="container-page py-10">
      <nav aria-label={t('product.breadcrumb')} class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-1.5" role="list">
          <li><a class="hover:text-brand-700" href={localePath(locale)}>{t('nav.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="hover:text-brand-700" href={localePath(locale, '/catalog')}>{t('nav.catalog')}</a></li>
          {product.category && (
            <>
              <li aria-hidden="true">/</li>
              <li><a class="hover:text-brand-700" href={localePath(locale, `/catalog/${product.category.slug}`)}>{product.category.name}</a></li>
            </>
          )}
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{product.name}</li>
        </ol>
      </nav>

      <div class="mt-6 grid gap-10 lg:grid-cols-2">
        <section aria-label={t('product.gallery')}>
          <div class="card aspect-square overflow-hidden bg-surface">
            {hero ? (
              <img src={hero.url} alt={hero.alt} width="800" height="800" class="h-full w-full object-contain p-6" fetchpriority="high" />
            ) : (
              <div class="flex h-full items-center justify-center text-brand-200" role="img" aria-label={t('product.noImage')}>
                <svg aria-hidden="true" viewBox="0 0 48 48" class="h-28 w-28" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 10c3.5-2 6.2-1 9 .6 2.8-1.6 5.5-2.6 9-.6 4 2.5 3.8 8.4 2.3 13.5-1.4 4.8-2.4 11.5-5 11.5-2.4 0-2.7-6-6.3-6s-3.9 6-6.3 6c-2.6 0-3.6-6.7-5-11.5C11.2 18.4 11 12.5 15 10Z" /></svg>
              </div>
            )}
          </div>
          {product.images.length > 1 && (
            <ul class="mt-3 grid grid-cols-5 gap-2" role="list">
              {product.images.map((img) => (
                <li class="card aspect-square overflow-hidden bg-surface">
                  <img src={img.url} alt={img.alt} width="160" height="160" loading="lazy" class="h-full w-full object-contain p-1" />
                </li>
              ))}
            </ul>
          )}
        </section>

        <section>
          {product.brand && <p class="text-sm font-medium uppercase tracking-wide text-muted">{product.brand}</p>}
          <h1 class="mt-1 text-3xl font-bold tracking-tight text-ink">{product.name}</h1>
          {product.description && <p class="mt-4 text-muted">{product.description}</p>}

          <div class="mt-8">
            <VariantPicker
              client:load
              options={product.options}
              variants={product.variants.map((v) => ({ id: v.id, sku: v.sku, weight_g: v.weight_g, options: v.options }))}
              quotes={pickerQuotes}
              availability={availability}
              cartAction={localePath(locale, '/cart')}
              initialVariantId={initial?.id ?? ''}
              currency={currency}
              intlLocale={INTL_LOCALE[locale]}
              labels={labels}
            />
          </div>
        </section>
      </div>

      {product.variants.length > 1 && (
        <section class="mt-14" aria-labelledby="variants-title">
          <h2 id="variants-title" class="text-xl font-bold tracking-tight">{t('product.allVariants')}</h2>
          <p class="mt-1 text-sm text-muted">{t('product.variantsCount', { count: product.variants.length })}</p>
          <div class="card mt-4 overflow-x-auto">
            <table class="w-full min-w-[32rem] text-sm">
              <thead class="bg-surface text-left text-xs uppercase tracking-wide text-muted">
                <tr>
                  <th scope="col" class="px-4 py-3 font-semibold">{t('product.sku')}</th>
                  {product.options.map((o) => <th scope="col" class="px-4 py-3 font-semibold">{o.name}</th>)}
                  <th scope="col" class="px-4 py-3 text-right font-semibold">{t('product.price')}</th>
                  <th scope="col" class="px-4 py-3"><span class="sr-only">{t('product.viewOption')}</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {product.variants.map((v) => {
                  const q = quotes.get(v.id);
                  return (
                    <tr>
                      <td class="px-4 py-3 font-mono text-xs">{v.sku}</td>
                      {product!.options.map((o) => <td class="px-4 py-3">{optionLabel(o.code, v.options[o.code] ?? '')}</td>)}
                      <td class="px-4 py-3 text-right font-semibold">{q ? formatMoney(q.unit_price, currency, locale) : <span class="font-normal text-muted">{t('product.priceOnRequest')}</span>}</td>
                      <td class="px-4 py-3 text-right">
                        <a class="text-brand-700 hover:underline" href={`?variant=${v.id}`} aria-label={`${t('product.viewOption')} ${v.sku}`}>{t('product.viewOption')}</a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="mt-2 text-xs text-muted">{t('product.taxNote')}</p>
        </section>
      )}
    </div>
  )}
</Layout>
