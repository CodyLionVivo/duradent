---
import Layout from '../../layouts/Layout.astro';
import { formatMoney, isLocale, localePath, useTranslations } from '../../i18n';
import { ApiError, unwrap, type Schemas } from '../../lib/api/client';
import { apiErrorText } from '../../lib/account';
import { setCartKey } from '../../lib/session';

if (!isLocale(Astro.params.locale)) return new Response(null, { status: 404 });

const { locale, currency, api, user } = Astro.locals;
const t = useTranslations(locale);
const here = localePath(locale, '/cart');
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const variant = String(form.get('variant_id') ?? '');
  const qty = Math.trunc(Number(form.get('qty') ?? 1));
  try {
    if (intent === 'add') {
      const cart = unwrap(await api.POST('/v1/cart/items', { params: { query: { currency, locale } }, body: { variant_id: variant, qty } }));
      if (cart.key) setCartKey(Astro.cookies, cart.key);
      return Astro.redirect(`${here}?added=1`, 303);
    }
    if (intent === 'set') {
      unwrap(await api.PUT('/v1/cart/items/{variant}', { params: { path: { variant }, query: { currency, locale } }, body: { qty } }));
    } else if (intent === 'remove') {
      unwrap(await api.DELETE('/v1/cart/items/{variant}', { params: { path: { variant }, query: { currency, locale } } }));
    }
    return Astro.redirect(here, 303);
  } catch (err) {
    error = apiErrorText(t, err);
    Astro.response.status = err instanceof ApiError ? err.status : 500;
  }
}

let cart: Schemas['Cart'] | null = null;
try {
  cart = unwrap(await api.GET('/v1/cart', { params: { query: { currency, locale } } }));
} catch (err) {
  error ||= apiErrorText(t, err);
}
const added = Astro.url.searchParams.get('added') === '1';
const problemText = (l: Schemas['CartLine']) =>
  l.problem === 'unavailable'
    ? t('cart.unavailable')
    : l.problem === 'not_priced'
      ? t('cart.notPriced')
      : l.problem === 'insufficient_stock'
        ? t('cart.insufficient', { count: l.available })
        : '';
const checkoutHref = user ? localePath(locale, '/checkout') : `${localePath(locale, '/account/login')}?next=${encodeURIComponent(localePath(locale, '/checkout'))}`;
---

<Layout title={t('cart.title')}>
  <div class="container-page py-10">
    <h1 class="text-3xl font-bold tracking-tight">{t('cart.title')}</h1>
    {added && <p role="status" class="mt-4 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-900">{t('cart.added')}</p>}
    {error && <p role="alert" class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}

    {!cart || cart.lines.length === 0 ? (
      <div class="card mt-8 p-10 text-center">
        <p class="font-semibold">{t('cart.empty')}</p>
        <a href={localePath(locale, '/catalog')} class="btn-primary mt-6">{t('cart.continue')}</a>
      </div>
    ) : (
      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <ul class="card divide-y divide-line" role="list">
          {cart.lines.map((l) => (
            <li class:list={['flex gap-4 p-4', l.problem && 'bg-red-50/40']}>
              <a href={localePath(locale, `/product/${l.product_slug}?variant=${l.variant_id}`)} class="h-20 w-20 shrink-0 overflow-hidden rounded-lg bg-surface">
                {l.image_url ? <img src={l.image_url} alt="" class="h-full w-full object-contain p-1" loading="lazy" /> : <span class="block h-full w-full" />}
              </a>
              <div class="min-w-0 flex-1">
                <a href={localePath(locale, `/product/${l.product_slug}?variant=${l.variant_id}`)} class="font-semibold hover:text-brand-700">{l.product_name}</a>
                {l.options && <p class="text-sm text-muted">{l.options}</p>}
                <p class="font-mono text-xs text-muted">{l.sku}</p>
                {l.problem && <p class="mt-1 text-sm font-medium text-red-700">{problemText(l)}</p>}
                <div class="mt-3 flex flex-wrap items-end gap-3">
                  <form method="post" class="flex items-end gap-2">
                    <input type="hidden" name="intent" value="set" />
                    <input type="hidden" name="variant_id" value={l.variant_id} />
                    <label>
                      <span class="sr-only">{t('cart.quantity')} {l.product_name}</span>
                      <input type="number" name="qty" min="1" max="9999" value={l.qty} class="input w-20" />
                    </label>
                    <button class="btn-secondary px-3 py-2 text-xs">{t('cart.update')}</button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="intent" value="remove" />
                    <input type="hidden" name="variant_id" value={l.variant_id} />
                    <button class="text-sm text-red-700 hover:underline">{t('cart.remove')}</button>
                  </form>
                </div>
              </div>
              <div class="text-right">
                {l.line_total && <p class="font-semibold">{formatMoney(l.line_total, currency, locale)}</p>}
                {l.unit_price && <p class="text-xs text-muted">{formatMoney(l.unit_price, currency, locale)} {t('product.perUnit')}</p>}
              </div>
            </li>
          ))}
        </ul>

        <aside class="card h-fit p-6" aria-labelledby="summary-title">
          <h2 id="summary-title" class="text-lg font-semibold">{t('checkout.summary')}</h2>
          <dl class="mt-4 space-y-2 text-sm">
            <div class="flex justify-between"><dt>{t('cart.items', { count: cart.item_count })}</dt><dd></dd></div>
            <div class="flex justify-between text-base font-semibold"><dt>{t('cart.subtotal')}</dt><dd>{formatMoney(cart.subtotal, currency, locale)}</dd></div>
          </dl>
          <p class="mt-2 text-xs text-muted">{t('cart.taxNote')}</p>
          {!cart.ready && <p class="mt-4 text-sm text-red-700">{t('cart.fixProblems')}</p>}
          {cart.ready ? (
            <a href={checkoutHref} class="btn-primary mt-6 w-full py-3">{user ? t('cart.checkout') : t('cart.signInToCheckout')}</a>
          ) : (
            <span class="btn-primary mt-6 w-full py-3" aria-disabled="true" style="opacity:.5;cursor:not-allowed">{t('cart.checkout')}</span>
          )}
          <a href={localePath(locale, '/catalog')} class="mt-3 block text-center text-sm text-brand-700 hover:underline">{t('cart.continue')}</a>
        </aside>
      </div>
    )}
  </div>
</Layout>
