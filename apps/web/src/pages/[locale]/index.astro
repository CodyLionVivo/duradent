---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ErrorState from '../../components/ErrorState.astro';
import HeroBackdrop from '../../components/HeroBackdrop.astro';
import HeroScene from '../../components/HeroScene.astro';
import CategoryArt from '../../components/CategoryArt.astro';
import { artKind } from '../../lib/art';
import { isLocale, localePath, useTranslations } from '../../i18n';
import { browseProducts, getCategories, getQuotes, topLevel, type Category, type ProductSummary, type Quote } from '../../lib/catalog';

if (!isLocale(Astro.params.locale)) return new Response(null, { status: 404 });

const { locale } = Astro.locals;
const t = useTranslations(locale);

let categories: Category[] = [];
let featured: ProductSummary[] = [];
let quotes = new Map<string, Quote>();
let failed = false;
try {
  [categories, { items: featured }] = await Promise.all([
    getCategories(Astro.locals.api, locale).then(topLevel),
    browseProducts(Astro.locals.api, { locale, category: 'brackets', pageSize: 8 }),
  ]);
  quotes = await getQuotes(Astro.locals.api, featured.map((p) => p.default_variant_id ?? ''));
} catch {
  failed = true;
  Astro.response.status = 503;
}

const values = [
  { title: t('home.valueShippingTitle'), text: t('home.valueShippingText'), icon: 'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z' },
  { title: t('home.valueInvoiceTitle'), text: t('home.valueInvoiceText'), icon: 'M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7' },
  { title: t('home.valuePricesTitle'), text: t('home.valuePricesText'), icon: 'M4 12 12 4h8v8l-8 8zM15.5 8.5h.01' },
];
---

<Layout>
  {failed ? (
    <ErrorState kind="unavailable" />
  ) : (
    <>
      <section class="hero relative isolate overflow-hidden" data-hero>
        <HeroBackdrop />
        <div class="container-page relative grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1fr_1fr] lg:gap-14 lg:py-20">
          <div class="hero-copy">
            <p class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>{t('home.eyebrow')}
            </p>
            <h1 class="mt-5 text-4xl font-bold tracking-tight text-ink sm:text-5xl lg:text-6xl">
              {t('home.heroTitle')}
            </h1>
            <p class="mt-5 max-w-xl text-lg text-muted">{t('home.heroSubtitle')}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={localePath(locale, '/catalog')} class="btn-primary btn-glow px-6 py-3 text-base">{t('home.heroCta')} <span aria-hidden="true">→</span></a>
              <a href={localePath(locale, '/catalog/brackets')} class="btn-secondary px-6 py-3 text-base">{t('home.heroSecondary')}</a>
            </div>
          </div>
          <HeroScene
            alt={t('home.storeAlt')}
            caption={t('home.storeCaption')}
            address={t('home.storeAddress')}
            chips={values.map((v) => ({ label: v.title, icon: v.icon }))}
          />
        </div>
      </section>

      <section class="container-page py-14" aria-labelledby="cat-title">
        <h2 id="cat-title" class="text-2xl font-bold tracking-tight">{t('home.categoriesTitle')}</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {categories.map((c) => (
            <li class="reveal">
              <a href={localePath(locale, `/catalog/${c.slug}`)} class="category-card group">
                <span class="category-art-tile">
                  <CategoryArt kind={artKind(categories, c.id)} class="h-16 w-16 transition-transform duration-500 group-hover:-translate-y-1 group-hover:rotate-[-4deg] group-hover:scale-110" />
                </span>
                <span class="flex min-w-0 flex-1 flex-col">
                  <span class="text-lg font-semibold text-ink group-hover:text-brand-700">{c.name}</span>
                  {c.description && <span class="mt-1 text-sm text-muted">{c.description}</span>}
                </span>
                <span aria-hidden="true" class="self-center text-lg font-semibold text-brand-700 transition-transform duration-300 group-hover:translate-x-1">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {featured.length > 0 && (
        <section class="container-page py-6" aria-labelledby="featured-title">
          <div class="flex items-end justify-between gap-4">
            <h2 id="featured-title" class="text-2xl font-bold tracking-tight">{t('home.featuredTitle')}</h2>
            <a href={localePath(locale, '/catalog')} class="text-sm font-semibold text-brand-700 hover:underline">{t('home.seeAll')} →</a>
          </div>
          <ul class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4" role="list">
            {featured.map((p, i) => (
              <li class="reveal"><ProductCard product={p} quote={quotes.get(p.default_variant_id ?? '')} eager={i < 4} /></li>
            ))}
          </ul>
        </section>
      )}

      <section class="container-page py-14" aria-labelledby="values-title">
        <div class="values-band reveal">
          <h2 id="values-title" class="text-2xl font-bold tracking-tight text-white">{t('home.valuesTitle')}</h2>
          <ul class="mt-8 grid gap-5 md:grid-cols-3" role="list">
            {values.map((v) => (
              <li class="value-tile">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15 text-white ring-1 ring-white/25">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d={v.icon} /></svg>
                </span>
                <div>
                  <h3 class="font-semibold text-white">{v.title}</h3>
                  <p class="mt-1 text-sm text-brand-50">{v.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </>
  )}
</Layout>

<script>
  // Looping hero animations pause while the hero is off screen and while the
  // visitor is scrolling, so they never compete with the scroll for frames.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    let visible = true;
    let scrolling = false;
    let idle: number | undefined;
    const update = () => hero.toggleAttribute('data-paused', !visible || scrolling);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        update();
      }).observe(hero);
    }
    addEventListener(
      'scroll',
      () => {
        if (!scrolling) {
          scrolling = true;
          update();
        }
        clearTimeout(idle);
        idle = window.setTimeout(() => {
          scrolling = false;
          update();
        }, 180);
      },
      { passive: true },
    );
  }
</script>
