---
// One sheet of the Libro de Reclamaciones and, while open, the answer form.
// The answer is emailed to the consumer and cannot be changed afterwards.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ComplaintSheet from '../../../components/ComplaintSheet.astro';
import { ApiError, unwrap, type Schemas } from '../../../lib/api/client';
import { errorMessage, savedRedirect, str } from '../../../lib/admin';
import { daysLeft } from '../../../lib/complaints';
import { formatDate, formatDay, useTranslations } from '../../../i18n';

const adminApi = Astro.locals.api;
const t = useTranslations('es');
const id = Astro.params.id ?? '';
let error = '';
let draft = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  draft = str(form, 'response');
  try {
    unwrap(await adminApi.POST('/v1/admin/complaints/{id}/answer', { params: { path: { id } }, body: { response: draft } }));
    return Astro.redirect(savedRedirect(new URL(Astro.url.pathname, Astro.url)), 303);
  } catch (err) {
    error = errorMessage(err);
    Astro.response.status = err instanceof ApiError ? err.status : 500;
  }
}

let c: Schemas['Complaint'] | null = null;
try {
  c = unwrap(await adminApi.GET('/v1/admin/complaints/{id}', { params: { path: { id } } }));
} catch (err) {
  if (err instanceof ApiError && (err.status === 404 || err.status === 400)) return new Response(null, { status: 404 });
  error ||= errorMessage(err);
}
const left = c ? daysLeft(c.due_at, new Date()) : 0;
const late = c?.status === 'open' && left < 0;
---

<AdminLayout title={c ? `${t('admin.complaints.number')} ${c.code}` : t('admin.complaints.title')} error={error}>
  {c && (
    <div class="space-y-6">
      <div class="flex flex-wrap items-center gap-3 print:hidden">
        <a href="/admin/complaints" class="text-sm text-muted hover:text-ink">← {t('admin.common.back')}</a>
        {c.status === 'answered'
          ? <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800">{t('admin.complaints.answeredBadge')}</span>
          : <span class:list={['rounded-full px-2 py-0.5 text-xs font-semibold', late ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-900']}>{late ? t('admin.complaints.overdueBadge') : t('admin.complaints.open')}</span>}
        {c.status === 'open' && (
          <span class:list={['text-sm', late ? 'font-semibold text-red-700' : 'text-muted']}>
            {t('admin.complaints.due')} {formatDay(c.due_at, 'es')} · {late ? t('admin.complaints.late', { days: -left }) : left === 0 ? t('admin.complaints.dueToday') : t('admin.complaints.dueIn', { days: left })}
          </span>
        )}
        <button type="button" class="btn-secondary ml-auto py-2" data-print>{t('complaints.print')}</button>
      </div>

      {c.status === 'open' && (
        <section class="card p-6 print:hidden" aria-labelledby="answer-title">
          <h2 id="answer-title" class="text-lg font-semibold">{t('admin.complaints.answerTitle')}</h2>
          <p class="mt-1 text-sm text-muted">{t('admin.complaints.answerHint')}</p>
          {c.response_channel === 'address' && (
            <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">{t('admin.complaints.answerLetter')}</p>
          )}
          <form method="post" class="mt-4 space-y-3" data-confirm={t('admin.complaints.answerConfirm')}>
            <label for="response" class="label">{t('complaints.response')}</label>
            <textarea id="response" name="response" required maxlength={5000} rows={8} class="input">{draft}</textarea>
            <button class="btn-primary">{t('admin.complaints.answerSubmit')}</button>
          </form>
        </section>
      )}
      {c.status === 'answered' && c.answered_at && (
        <p class="text-sm text-muted print:hidden">{t('admin.complaints.answeredBy', { date: formatDate(c.answered_at, 'es'), by: c.answered_by ?? 'admin' })}</p>
      )}

      <ComplaintSheet complaint={c} locale="es" />
    </div>
  )}
</AdminLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      if (!confirm(form.dataset.confirm ?? '')) e.preventDefault();
    });
  });
</script>
