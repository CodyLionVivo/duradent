---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import OrderStatus from '../../../components/OrderStatus.astro';
import { unwrap, type Schemas } from '../../../lib/api/client';
import { errorMessage } from '../../../lib/admin';
import { formatDate, formatMoney, useTranslations } from '../../../i18n';

const adminApi = Astro.locals.api;
const t = useTranslations('es');
const q = Astro.url.searchParams.get('q') ?? '';
const statusParam = Astro.url.searchParams.get('status') ?? '';
const statuses = ['pending_payment', 'paid', 'preparing', 'shipped', 'delivered', 'cancelled'] as const;
const status = statuses.find((s) => s === statusParam);
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);

let error = '';
let data: Schemas['OrderPage'] = { items: [], total: 0, page, page_size: 50 };
try {
  data = unwrap(await adminApi.GET('/v1/admin/orders', { params: { query: { q: q || undefined, status, page } } }));
} catch (err) {
  error = errorMessage(err);
}
const tab = (s: string) => {
  const u = new URL(Astro.url);
  if (s) u.searchParams.set('status', s);
  else u.searchParams.delete('status');
  u.searchParams.delete('page');
  return u.pathname + u.search;
};
---

<AdminLayout title={t('admin.orders.title')} error={error}>
  <nav aria-label={t('admin.orders.status')} class="flex flex-wrap gap-2">
    {[['', t('admin.orders.all')], ...statuses.map((s) => [s, t(`status.${s}`)])].map(([s, label]) => (
      <a href={tab(s)} aria-current={statusParam === s ? 'page' : undefined}
        class:list={['rounded-full border px-3 py-1 text-sm', statusParam === s ? 'border-brand-700 bg-brand-700 text-white' : 'border-line bg-white hover:border-brand-500']}>{label}</a>
    ))}
  </nav>
  <form method="get" class="mt-4 flex flex-wrap items-end gap-2">
    {status && <input type="hidden" name="status" value={status} />}
    <div>
      <label for="q" class="label">{t('admin.common.search')}</label>
      <input id="q" name="q" type="search" value={q} placeholder={t('admin.orders.search')} class="input w-80" />
    </div>
    <button class="btn-secondary">{t('admin.common.search')}</button>
  </form>
  <p class="mt-4 text-sm text-muted">{t('admin.orders.count', { count: data.total })}</p>

  {data.items.length === 0 ? (
    <p class="card mt-4 p-8 text-center text-muted">{t('admin.orders.empty')}</p>
  ) : (
    <div class="card mt-4 overflow-x-auto">
      <table class="w-full min-w-[48rem] text-sm">
        <thead class="bg-surface text-left text-xs uppercase tracking-wide text-muted">
          <tr>
            <th scope="col" class="px-4 py-3">{t('admin.orders.number')}</th>
            <th scope="col" class="px-4 py-3">{t('admin.orders.customer')}</th>
            <th scope="col" class="px-4 py-3">{t('admin.orders.method')}</th>
            <th scope="col" class="px-4 py-3">{t('admin.orders.status')}</th>
            <th scope="col" class="px-4 py-3 text-right">{t('admin.orders.total')}</th>
            <th scope="col" class="px-4 py-3">{t('admin.orders.date')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {data.items.map((o) => (
            <tr class="hover:bg-surface/60">
              <td class="px-4 py-3"><a href={`/admin/orders/${o.id}`} class="font-semibold text-brand-800 hover:underline">{o.number}</a></td>
              <td class="px-4 py-3"><p>{o.billing.business_name}</p><p class="text-xs text-muted">{o.email} · {o.billing.document_type} {o.billing.document_number}</p></td>
              <td class="px-4 py-3">{t(`admin.orders.${o.payment_method}`)}</td>
              <td class="px-4 py-3"><OrderStatus status={o.status} /></td>
              <td class="px-4 py-3 text-right font-semibold tabular-nums">{formatMoney(o.total, 'es')}</td>
              <td class="px-4 py-3 text-muted">{formatDate(o.created_at, 'es')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <Pagination page={page} pageSize={50} total={data.total} />
</AdminLayout>
