---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import OrderStatus from '../../../components/OrderStatus.astro';
import { ApiError, unwrap, type Schemas } from '../../../lib/api/client';
import { errorMessage, savedRedirect, str } from '../../../lib/admin';
import { departmentName } from '../../../lib/account';
import { formatDate, formatMoney, useTranslations } from '../../../i18n';

const adminApi = Astro.locals.api;
const t = useTranslations('es');
const id = Astro.params.id ?? '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const path = { id };
  try {
    switch (str(form, 'intent')) {
      case 'confirm_transfer':
        unwrap(await adminApi.POST('/v1/admin/orders/{id}/confirm-transfer', { params: { path }, body: { reference: str(form, 'reference') } }));
        break;
      case 'prepare':
        unwrap(await adminApi.POST('/v1/admin/orders/{id}/prepare', { params: { path } }));
        break;
      case 'ship':
        unwrap(await adminApi.POST('/v1/admin/orders/{id}/ship', { params: { path }, body: { carrier: str(form, 'carrier'), tracking: str(form, 'tracking') } }));
        break;
      case 'deliver':
        unwrap(await adminApi.POST('/v1/admin/orders/{id}/deliver', { params: { path } }));
        break;
      case 'cancel':
        unwrap(await adminApi.POST('/v1/admin/orders/{id}/cancel', { params: { path }, body: { reason: str(form, 'reason') } }));
        break;
      case 'refund':
        unwrap(await adminApi.POST('/v1/admin/orders/{id}/refund', { params: { path }, body: { reason: str(form, 'reason'), reference: str(form, 'reference') } }));
        break;
      case 'retry_invoice':
        unwrap(await adminApi.POST('/v1/admin/invoices/{id}/retry', { params: { path: { id: str(form, 'invoice') } } }));
        break;
    }
    return Astro.redirect(savedRedirect(new URL(Astro.url.pathname, Astro.url)), 303);
  } catch (err) {
    error = errorMessage(err);
    Astro.response.status = 422;
  }
}

type Detail = {
  order: Schemas['Order'];
  payments: Schemas['Payment'][];
  history: { from: string; to: string; actor: string; note: string; at: string }[];
};
let d: Detail | null = null;
try {
  d = unwrap(await adminApi.GET('/v1/admin/orders/{id}', { params: { path: { id } } }));
} catch (err) {
  if (err instanceof ApiError && err.status === 404) return new Response(null, { status: 404 });
  error ||= errorMessage(err);
}
const o = d?.order;
const invoices = o ? ((await adminApi.GET('/v1/admin/orders/{id}/invoices', { params: { path: { id } } })).data?.items ?? []) : [];
const paid = d?.payments.some((p) => p.status === 'confirmed') ?? false;
const refundable = !!o && paid && !o.refunded_at && ['paid', 'preparing', 'cancelled'].includes(o.status);
const money = (v: string) => formatMoney(v, 'es');
const statusLabel = (s: string) => (s ? t(`status.${s as 'paid'}`) : '—');
---

<AdminLayout title={o ? `${t('admin.orders.number')} ${o.number}` : t('admin.orders.detail')} error={error}>
  {o && d && (
    <div class="space-y-6">
      <div class="flex flex-wrap items-center gap-3">
        <a href="/admin/orders" class="text-sm text-muted hover:text-ink">← {t('admin.common.back')}</a>
        <OrderStatus status={o.status} />
        <span class="text-sm text-muted">{t(`admin.orders.${o.payment_method}`)} · {formatDate(o.created_at, 'es')}</span>
      </div>

      <section class="card p-6" aria-labelledby="actions-title">
        <h2 id="actions-title" class="text-lg font-semibold">{t('admin.orders.actions')}</h2>
        <div class="mt-4 flex flex-wrap items-end gap-4">
          {o.status === 'pending_payment' && o.payment_method === 'bank_transfer' && (
            <form method="post" class="flex items-end gap-2">
              <input type="hidden" name="intent" value="confirm_transfer" />
              <div>
                <label for="reference" class="label">{t('admin.orders.reference')}</label>
                <input id="reference" name="reference" required maxlength="60" class="input w-48" />
              </div>
              <button class="btn-primary">{t('admin.orders.confirmTransfer')}</button>
            </form>
          )}
          {o.status === 'paid' && (
            <form method="post"><input type="hidden" name="intent" value="prepare" /><button class="btn-primary">{t('admin.orders.prepare')}</button></form>
          )}
          {(o.status === 'paid' || o.status === 'preparing') && (
            <form method="post" class="flex flex-wrap items-end gap-2">
              <input type="hidden" name="intent" value="ship" />
              <div>
                <label for="carrier" class="label">{t('admin.orders.carrier')}</label>
                <input id="carrier" name="carrier" maxlength="60" class="input w-44" placeholder="Olva Courier" required={!o.shipping.pickup} />
              </div>
              <div>
                <label for="tracking" class="label">{t('admin.orders.trackingNumber')}</label>
                <input id="tracking" name="tracking" maxlength="80" class="input w-44" />
              </div>
              <button class="btn-primary">{t('admin.orders.ship')}</button>
            </form>
          )}
          {o.status === 'shipped' && (
            <form method="post"><input type="hidden" name="intent" value="deliver" /><button class="btn-primary">{t('admin.orders.deliver')}</button></form>
          )}
          {o.status === 'pending_payment' && (
            <form method="post" class="flex items-end gap-2" data-confirm={t('admin.common.confirmDelete')}>
              <input type="hidden" name="intent" value="cancel" />
              <div>
                <label for="reason" class="label">{t('admin.orders.cancelReason')}</label>
                <input id="reason" name="reason" maxlength="200" class="input w-56" />
              </div>
              <button class="btn-danger">{t('admin.orders.cancel')}</button>
            </form>
          )}
          {refundable && o && (
            <form method="post" class="flex flex-wrap items-end gap-2" data-confirm={t('admin.orders.refundConfirm', { amount: money(o.total) })}>
              <input type="hidden" name="intent" value="refund" />
              <div>
                <label for="refund-reason" class="label">{t('admin.orders.refundReason')}</label>
                <input id="refund-reason" name="reason" required maxlength="200" class="input w-56" />
              </div>
              {o.payment_method === 'bank_transfer' && (
                <div>
                  <label for="refund-reference" class="label">{t('admin.orders.refundReference')}</label>
                  <input id="refund-reference" name="reference" required maxlength="60" class="input w-44" />
                </div>
              )}
              <button class="btn-danger">{t('admin.orders.refund')}</button>
            </form>
          )}
          {o.refunded_at && <p class="text-sm font-medium text-emerald-800">{t('admin.orders.refundedOn', { date: formatDate(o.refunded_at, 'es'), ref: o.refund_ref })}</p>}
          {o.status === 'pending_payment' && <p class="text-sm text-muted">{t('admin.orders.deadline')}: {formatDate(o.payment_deadline, 'es')}</p>}
        </div>
      </section>

      <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
        <section class="card overflow-x-auto">
          <table class="w-full min-w-[32rem] text-sm">
            <thead class="bg-surface text-left text-xs uppercase tracking-wide text-muted">
              <tr><th class="px-4 py-2">SKU</th><th class="px-4 py-2">{t('admin.common.name')}</th><th class="px-4 py-2 text-right">{t('orders.qty')}</th><th class="px-4 py-2 text-right">{t('orders.unitPrice')}</th><th class="px-4 py-2 text-right">{t('admin.orders.total')}</th></tr>
            </thead>
            <tbody class="divide-y divide-line">
              {o.lines.map((l) => (
                <tr>
                  <td class="px-4 py-2 font-mono text-xs">{l.sku}</td>
                  <td class="px-4 py-2">{l.name}{l.options && <span class="block text-xs text-muted">{l.options}</span>}</td>
                  <td class="px-4 py-2 text-right">{l.qty}</td>
                  <td class="px-4 py-2 text-right">{money(l.unit_price)}</td>
                  <td class="px-4 py-2 text-right">{money(l.line_total)}</td>
                </tr>
              ))}
            </tbody>
            <tfoot class="text-sm">
              <tr><td colspan="4" class="px-4 py-1 text-right text-muted">{t('orders.subtotal')}</td><td class="px-4 py-1 text-right">{money(o.subtotal)}</td></tr>
              <tr><td colspan="4" class="px-4 py-1 text-right text-muted">{t('orders.shipping')}</td><td class="px-4 py-1 text-right">{money(o.shipping_amount)}</td></tr>
              <tr><td colspan="4" class="px-4 py-1 text-right text-muted">{t('orders.tax')}</td><td class="px-4 py-1 text-right">{money(o.tax)}</td></tr>
              <tr class="font-bold"><td colspan="4" class="px-4 py-2 text-right">{t('admin.orders.total')}</td><td class="px-4 py-2 text-right">{money(o.total)}</td></tr>
            </tfoot>
          </table>
        </section>

        <section class="card space-y-4 p-6 text-sm">
          <div>
            <h2 class="font-semibold">{t('admin.orders.customer')}</h2>
            <p class="text-muted">{o.billing.business_name}<br />{o.billing.document_type} {o.billing.document_number} · {o.billing.invoice_type === '01' ? t('orders.invoice01') : t('orders.invoice03')}<br />{o.email}</p>
          </div>
          <div>
            <h2 class="font-semibold">{t('orders.deliverTo')}</h2>
            {o.shipping.pickup ? <p class="text-muted">{t('checkout.zone_pickup')}</p> : (
              <p class="text-muted">{o.shipping.recipient}{o.shipping.phone && ` · ${o.shipping.phone}`}<br />{o.shipping.line1}{o.shipping.reference && <><br />{o.shipping.reference}</>}<br />{o.shipping.district}, {o.shipping.province}, {departmentName(o.shipping.department ?? '')}</p>
            )}
            {o.tracking && <p class="mt-1">{o.carrier} · {o.tracking}</p>}
          </div>
          {o.notes && <div><h2 class="font-semibold">{t('orders.notes')}</h2><p class="text-muted">{o.notes}</p></div>}
        </section>
      </div>

      <section class="card p-6" aria-labelledby="payments-title">
        <h2 id="payments-title" class="text-lg font-semibold">{t('admin.orders.payments')}</h2>
        {d.payments.length === 0 ? <p class="mt-2 text-sm text-muted">{t('admin.orders.noPayments')}</p> : (
          <ul class="mt-3 divide-y divide-line text-sm" role="list">
            {d.payments.map((p) => (
              <li class="flex flex-wrap justify-between gap-2 py-2">
                <span>
                  <span class:list={['font-semibold', p.status === 'failed' ? 'text-red-700' : p.status === 'refunded' ? 'text-amber-800' : 'text-emerald-700']}>{t(`admin.orders.payment_${p.status}`)}</span>
                  {' · '}{t(`admin.orders.${p.method}`)}{p.source_type && ` (${p.source_type})`}
                  {p.provider_ref && <span class="font-mono text-xs text-muted"> {p.provider_ref}</span>}
                  {p.reference && <span class="text-muted"> · {t('admin.orders.reference')} {p.reference}</span>}
                  {p.failure_message && <span class="block text-xs text-muted">{p.failure_code}: {p.failure_message}</span>}
                </span>
                <span class="text-muted">{money(p.amount)} · {formatDate(p.created_at, 'es')}</span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="card p-6" aria-labelledby="invoices-title">
        <h2 id="invoices-title" class="text-lg font-semibold">{t('admin.invoices.title')}</h2>
        {invoices.length === 0 ? <p class="mt-2 text-sm text-muted">{t('admin.invoices.none')}</p> : (
          <ul class="mt-3 divide-y divide-line text-sm" role="list">
            {invoices.map((inv) => (
              <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                <span>
                  <strong>{inv.name}</strong> · <span class:list={[inv.status === 'accepted' ? 'text-emerald-700' : inv.status === 'rejected' ? 'text-red-700' : 'text-amber-800']}>{t(`admin.invoices.status_${inv.status}`)}</span>
                  {inv.sunat_description && <span class="block text-xs text-muted">{inv.sunat_description}</span>}
                  {inv.last_error && <span class="block text-xs text-red-700">{inv.last_error}</span>}
                </span>
                <span class="flex items-center gap-3">
                  {inv.pdf_url && <a href={inv.pdf_url} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 hover:underline">PDF</a>}
                  {inv.xml_url && <a href={inv.xml_url} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 hover:underline">XML</a>}
                  {inv.status === 'rejected' && (
                    <form method="post"><input type="hidden" name="intent" value="retry_invoice" /><input type="hidden" name="invoice" value={inv.id} /><button class="btn-secondary">{t('admin.invoices.retry')}</button></form>
                  )}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="card p-6" aria-labelledby="history-title">
        <h2 id="history-title" class="text-lg font-semibold">{t('admin.orders.history')}</h2>
        <ol class="mt-3 space-y-2 text-sm">
          {d.history.map((h) => (
            <li class="flex flex-wrap gap-2"><span class="text-muted">{formatDate(h.at, 'es')}</span><span>{statusLabel(h.from)} → <strong>{statusLabel(h.to)}</strong></span><span class="text-xs text-muted">{h.actor}{h.note && ` · ${h.note}`}</span></li>
          ))}
        </ol>
      </section>
    </div>
  )}
</AdminLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      if (!confirm(form.dataset.confirm ?? '')) e.preventDefault();
    });
  });
</script>
