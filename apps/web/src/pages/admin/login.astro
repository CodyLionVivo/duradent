---
import '../../styles/global.css';
import Logo from '../../components/Logo.astro';
import { ADMIN_TOKEN } from 'astro:env/server';
import { ADMIN_COOKIE, isAdmin } from '../../middleware';
import { safeReturnPath } from '../../lib/urls';
import { useTranslations } from '../../i18n';

const t = useTranslations('es');
const next = safeReturnPath(Astro.url.searchParams.get('next'));
const target = next.startsWith('/admin') ? next : '/admin/products';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const token = String(form.get('token') ?? '');
  if (isAdmin(token)) {
    Astro.cookies.set(ADMIN_COOKIE, token, {
      path: '/admin',
      httpOnly: true,
      sameSite: 'strict',
      secure: import.meta.env.PROD,
      maxAge: 60 * 60 * 8,
    });
    return Astro.redirect(target, 303);
  }
  error = t('admin.login.invalid');
  Astro.response.status = 401;
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t('admin.login.title')} · Duradent</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-surface p-4 antialiased">
    <main class="card w-full max-w-sm p-8">
      <Logo />
      <h1 class="mt-6 text-xl font-bold">{t('admin.login.title')}</h1>
      {!ADMIN_TOKEN ? (
        <p role="alert" class="mt-4 text-sm text-red-700">{t('admin.login.disabled')}</p>
      ) : (
        <form method="post" class="mt-6 space-y-4">
          <div>
            <label for="token" class="label">{t('admin.login.token')}</label>
            <input id="token" name="token" type="password" required autocomplete="current-password" class="input" aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'login-error' : 'login-hint'} />
          </div>
          {error && <p id="login-error" role="alert" class="text-sm text-red-700">{error}</p>}
          <button class="btn-primary w-full">{t('admin.login.submit')}</button>
          <p id="login-hint" class="text-xs text-muted">{t('admin.login.hint')}</p>
        </form>
      )}
    </main>
  </body>
</html>
