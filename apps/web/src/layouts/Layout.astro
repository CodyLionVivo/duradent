---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BrandIcons from '../components/BrandIcons.astro';
import { ALLOW_INDEXING, SITE_URL } from 'astro:env/server';
import { HTML_LANG, useTranslations } from '../i18n';
import { absolute, alternates, canonicalPath, isPrivatePath, jsonLdScript } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** schema.org structured data for this page (Product, BreadcrumbList…). */
  jsonLd?: Record<string, unknown>[];
}

const { locale } = Astro.locals;
const t = useTranslations(locale);
const { title, description = t('meta.description'), jsonLd = [] } = Astro.props;
// The tab shows only the page name ("Catálogo"), or "Duradent" on the home page.
const tabTitle = title ?? t('meta.siteName');
// Absolute URLs come from SITE_URL: behind the load balancer the request is http.
const canonicalP = canonicalPath(Astro.url);
const canonical = absolute(SITE_URL, canonicalP);
const found = (Astro.response.status ?? 200) < 400;
const indexable = ALLOW_INDEXING && found && !isPrivatePath(Astro.url.pathname);
const languages = found ? alternates(SITE_URL, canonicalP) : [];
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BrandIcons />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {languages.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('meta.siteName')} />
    <meta property="og:title" content={title ?? t('meta.title')} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(SITE_URL, '/brand/og-image.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={jsonLdScript(data)} />)}
  </head>
  <body class="flex min-h-screen flex-col bg-white antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow">
      {t('nav.skipToContent')}
    </a>
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
