---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BrandIcons from '../components/BrandIcons.astro';
import { HTML_LANG, LOCALES, switchLocalePath, useTranslations } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { locale } = Astro.locals;
const t = useTranslations(locale);
const { title, description = t('meta.description') } = Astro.props;
const fullTitle = title ? `${title} · ${t('meta.siteName')}` : t('meta.title');
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BrandIcons />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('meta.siteName')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/brand/og-image.png', Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(switchLocalePath(Astro.url, l), Astro.url).href} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col bg-white antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow">
      {t('nav.skipToContent')}
    </a>
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
